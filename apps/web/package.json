    "@tabler/icons-react": "^3.30.0",
    "@tanstack/react-query": "^5.66.9",
    "@tanstack/react-router": "^1.112.0",
    "dayjs": "^1.11.13",
    "mantine-contextmenu": "^8.0.0",
    "mantine-datatable": "^8.0.0",
