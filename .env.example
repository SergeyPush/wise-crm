# ─── БД ───
DATABASE_URL="postgresql://wisecrm:wisecrm@localhost:5433/wisecrm?schema=public"
TEST_DATABASE_URL="postgresql://wisecrm:wisecrm@localhost:5434/wisecrm_test?schema=public"

# ─── Приложение ───
NODE_ENV=development
PORT=3001                            # локально; у контейнера на проде остаётся 3000
TZ=Europe/Kyiv                      # NFR-45: дублируется явной зоной в коде
LOG_LEVEL=debug
APP_URL=http://localhost:5173       # для ссылок в уведомлениях; на проде https://crm.wisexpert.com.ua

# ─── Аутентификация ───
# Секреты подписи JWT. Сгенерировать: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars-long
COOKIE_SECURE=false                 # true на проде (HTTPS)

# Только адрес первого админа, НИКОГДА не пароль (FR-1.6):
# пароль генерируется при первом старте и печатается в лог один раз.
ADMIN_BOOTSTRAP_EMAIL=admin@wisexpert.com.ua

# ─── Внешние каналы (этап 4) ───
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
ALERT_TELEGRAM_CHAT_ID=

# ─── Приём заявок с сайта (этап 2, FR-W1) ───
WEB_FORM_TOKEN=

# ─── Файлы ───
UPLOAD_DIR=./uploads
