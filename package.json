{
  "name": "wise-crm",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter shared build && pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm --filter shared build && pnpm --filter api build && pnpm --filter web build",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:unit": "pnpm -r test:unit",
    "test:api": "pnpm --filter api test:api",
    "test:e2e": "playwright test",
    "db:up": "docker compose up -d postgres postgres_test",
    "db:migrate": "pnpm --filter api migrate:dev",
    "db:seed": "pnpm --filter api seed",
    "seed:dev": "pnpm --filter api seed:dev",
    "gen:api": "pnpm --filter web gen:api"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@types/node": "^22.13.5",
    "eslint": "^9.21.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.25.0",
    "prettier": "^3.5.2",
    "eslint-config-prettier": "^10.0.2",
    "@eslint/js": "^9.21.0"
  }
}
